# Copy this file to .env and fill in real values. Never commit .env.
# EAS reads these via `eas secret:create` for cloud builds — see README.

APP_ENV=development

# RevenueCat public SDK keys (safe to ship in the app bundle — these are
# NOT the same as the RevenueCat secret key, which stays on the backend).
REVENUECAT_API_KEY_IOS=
REVENUECAT_API_KEY_ANDROID=

# PayFast — merchant ID only. The merchant KEY and PASSPHRASE never go in
# the mobile app; they live in the backend's secret manager and are used
# server-side to sign payment requests and verify ITN callbacks.
PAYFAST_MERCHANT_ID=

# Sentry crash reporting
SENTRY_DSN=
